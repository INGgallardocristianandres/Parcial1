<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="700.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.ClienteViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Clientes" />

        <!-- Formulario -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Identificación (ID):" />
                <TextField fx:id="txtId" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Nombre Completo:" />
                <TextField fx:id="txtNombre" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Teléfono:" />
                <TextField fx:id="txtTelefono" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Correo Electrónico:" />
                <TextField fx:id="txtCorreo" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Edad:" />
                <TextField fx:id="txtEdad" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Fecha Registro:" />
                <DatePicker fx:id="dpFechaRegistro" prefWidth="250.0" />
            </children>
        </HBox>

        <!-- Botones de Acción -->
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#handleGuardarCliente" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Cliente" />
                <Button onAction="#handleEliminarCliente" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar Seleccionado" />
                <Button onAction="#onVolver" text="Volver" />
            </children>
        </HBox>

        <!-- Tabla de Clientes -->
        <TableView fx:id="tblClientes" prefHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
                <TableColumn fx:id="colCorreo" prefWidth="140.0" text="Correo" />
                <TableColumn fx:id="colEdad" prefWidth="60.0" text="Edad" />
                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Registro" />
            </columns>
        </TableView>
    </children>
</VBox>