<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.InscripcionViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Gestión de Inscripciones y Servicios Adicionales" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>

        <Separator prefWidth="200.0"/>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Código Inscripción:"/>
                <TextField fx:id="txtCodigoInscripcion" GridPane.columnIndex="1"/>

                <Label text="Descuento (%):" GridPane.columnIndex="2"/>
                <TextField fx:id="txtDescuento" GridPane.columnIndex="3"/>

                <Label text="Servicio Extra:" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbTipoServicio" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Button onAction="#handleAgregarServicio" text="Agregar Servicio"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            </children>
        </GridPane>

        <Button onAction="#handleCrearInscripcion" text="Crear e Inscribir (Builder)"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>

        <Separator prefWidth="200.0"/>

        <Label text="Inscripciones Registradas" textFill="#34495e">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Label>

        <TableView fx:id="tblInscripciones" prefHeight="200.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="250.0" text="Código Inscripción"/>
                <TableColumn fx:id="colTotal" prefWidth="250.0" text="Total a Pagar ($)"/>
            </columns>
        </TableView>
    </children>
</VBox>