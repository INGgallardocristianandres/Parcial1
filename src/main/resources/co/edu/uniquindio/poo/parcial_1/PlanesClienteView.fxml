<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.PlanesClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Gestión de Clientes y Selección de Planes" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Label>

        <Separator prefWidth="200.0"/>

        <!-- Sección 1: Datos del Cliente -->
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Identificación:"/>
                <TextField fx:id="txtIdentificacion" GridPane.columnIndex="1"/>
                <Label text="Nombre Completo:" GridPane.columnIndex="2"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="3"/>
                <Label text="Teléfono:" GridPane.rowIndex="1"/>
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </children>
        </GridPane>

        <Button fx:id="btnRegistrarCliente" onAction="#handleRegistrarCliente" text="Registrar Cliente"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Separator prefWidth="200.0"/>

        <!-- Sección 2: Configuración de Plan mediante Fábrica / Prototype -->
        <Label text="Planes Disponibles (Patrón Prototype / Factory)" textFill="#34495e">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Label>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Tipo de Plan:"/>
                <ComboBox fx:id="cmbTipoPlan" prefWidth="180.0"/>
                <Label text="Especialidad (Si aplica):"/>
                <ComboBox fx:id="cmbEspecialidad" prefWidth="180.0"/>
                <Button fx:id="btnClonarPlan" onAction="#handleClonarPlan" text="Clonar / Generar Plan"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Tabla de Resultados -->
        <TableView fx:id="tblPlanes" prefHeight="200.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código"/>
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre Plan"/>
                <TableColumn fx:id="colDuracion" prefWidth="100.0" text="Meses"/>
                <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Mensual"/>
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado"/>
            </columns>
        </TableView>
    </children>
</VBox>