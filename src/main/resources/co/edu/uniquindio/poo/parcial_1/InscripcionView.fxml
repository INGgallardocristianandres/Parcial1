<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="750.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.InscripcionViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Inscripciones (Builder &amp; Factory)" />

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Código Inscripción:" />
                <TextField fx:id="txtCodigoInscripcion" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Cliente:" />
                <ComboBox fx:id="cmbClientes" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Entrenador Responsable:" />
                <ComboBox fx:id="cmbEntrenadores" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Tipo de Plan:" />
                <ComboBox fx:id="cmbPlanes" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Descuento (%):" />
                <TextField fx:id="txtDescuento" prefWidth="250.0" text="0.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Servicio Adicional:" />
                <ComboBox fx:id="cmbTipoServicio" prefWidth="250.0" />
                <Button onAction="#handleAgregarServicio" text="Añadir Servicio" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Nuevo Estado Plan:" />
                <ComboBox fx:id="cmbNuevoEstado" prefWidth="250.0" />
                <Button onAction="#handleCambiarEstado" text="Actualizar Estado" />
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#handleCrearInscripcion" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Inscripción" />
                <Button onAction="#onVolver" text="Volver" />
            </children>
        </HBox>

        <TableView fx:id="tblInscripciones" prefHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                <TableColumn fx:id="colPlan" prefWidth="150.0" text="Plan" />
                <TableColumn fx:id="colEntrenador" prefWidth="150.0" text="Entrenador" />
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                <TableColumn fx:id="colTotal" prefWidth="90.0" text="Total ($)" />
            </columns>
        </TableView>
    </children>
</VBox>