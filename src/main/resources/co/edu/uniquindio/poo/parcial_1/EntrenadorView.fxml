<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="700.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.EntrenadorViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Entrenadores" />

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="ID / Identificación:" />
                <TextField fx:id="txtId" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Nombre Completo:" />
                <TextField fx:id="txtNombre" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Teléfono:" />
                <TextField fx:id="txtTelefono" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Correo Electrónico:" />
                <TextField fx:id="txtCorreo" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Especialidad:" />
                <ComboBox fx:id="cmbEspecialidad" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Tarifa por Hora:" />
                <TextField fx:id="txtTarifa" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#handleGuardarEntrenador" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Entrenador" />
                <Button onAction="#handleEliminarEntrenador" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar Seleccionado" />
                <Button onAction="#onVolver" text="Volver" />
            </children>
        </HBox>

        <TableView fx:id="tblEntrenadores" prefHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
                <TableColumn fx:id="colCorreo" prefWidth="130.0" text="Correo" />
                <TableColumn fx:id="colEspecialidad" prefWidth="100.0" text="Especialidad" />
                <TableColumn fx:id="colTarifa" prefWidth="80.0" text="Tarifa/h" />
            </columns>
        </TableView>
    </children>
</VBox>

