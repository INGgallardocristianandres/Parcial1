<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="750.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.AlertasViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #900c3f;" text="Alertas y Estado de Membresías" />
        <Label text="A continuación se listan únicamente las inscripciones con planes SUSPENDIDOS o CANCELADOS:" textFill="#555555" />

        <TableView fx:id="tblAlertas" prefHeight="350.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Cód. Inscripción" />
                <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                <TableColumn fx:id="colPlan" prefWidth="160.0" text="Plan de Entrenamiento" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado Actual" />
                <TableColumn fx:id="colTotal" prefWidth="110.0" text="Monto ($)" />
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#handleReactivarPlan" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Reactivar Plan Seleccionado" />
                <Button onAction="#onVolver" text="Volver" />
            </children>
        </HBox>
    </children>
</VBox>