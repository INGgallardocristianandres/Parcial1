<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="750.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial_1.viewController.PlanViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Planes de Entrenamiento (Factory Method)" />

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Código Plan:" />
                <TextField fx:id="txtCodigo" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Nombre del Plan:" />
                <TextField fx:id="txtNombre" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Tipo de Plan:" />
                <ComboBox fx:id="cmbTipoPlan" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Precio Base ($):" />
                <TextField fx:id="txtPrecio" prefWidth="250.0" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label prefWidth="150.0" text="Duración (Meses):" />
                <TextField fx:id="txtDuracion" prefWidth="250.0" text="1" />
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button onAction="#handleCrearPlan" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Crear Plan con Factory" />
                <Button onAction="#onVolver" text="Volver" />
            </children>
        </HBox>

        <TableView fx:id="tblPlanes" prefHeight="240.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
                <TableColumn fx:id="colDuracion" prefWidth="110.0" text="Duración (meses)" />
                <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio ($)" />
            </columns>
        </TableView>
    </children>
</VBox>